generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum QueueStatus {
  OPEN
  CLOSED
}

enum QueueEntryStatus {
  WAITING
  SERVED
  CANCELED
}

enum QueueEntryPriority {
  NORMAL
  PRIORITY
}

enum HistoryOutcome {
  SERVED
  LEFT
}

enum NotificationType {
  JOINED
  ALMOST_UP
  SERVED
}

model UserCredential {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  profile       UserProfile?
  queueEntries  QueueEntry[]
  notifications Notification[]
  history       History[]
}

model UserProfile {
  id          Int     @id @default(autoincrement())
  fullName    String
  email       String  @unique
  contactInfo String?
  preferences String?

  credentialId Int            @unique
  credential   UserCredential @relation(fields: [credentialId], references: [id])
}

model Service {
  id               Int    @id @default(autoincrement())
  name             String
  description      String
  expectedDuration Int
  priorityLevel    Int

  queues Queue[]
}

model Queue {
  id        Int         @id @default(autoincrement())
  status    QueueStatus @default(OPEN)
  createdAt DateTime    @default(now())

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  entries QueueEntry[]
}

model QueueEntry {
  id       Int                @id @default(autoincrement())
  position Int
  joinTime DateTime           @default(now())
  status   QueueEntryStatus   @default(WAITING)
  priority QueueEntryPriority @default(NORMAL)

  queueId Int
  queue   Queue @relation(fields: [queueId], references: [id])

  userId Int
  user   UserCredential @relation(fields: [userId], references: [id])

  @@index([queueId, status])
  @@index([queueId, priority, joinTime])
  @@index([userId, status])
}

model History {
  id          Int            @id @default(autoincrement())
  serviceId   Int
  serviceName String
  joinedAt    DateTime
  endedAt     DateTime       @default(now())
  waitMinutes Int
  outcome     HistoryOutcome

  userId Int
  user   UserCredential @relation(fields: [userId], references: [id])

  @@index([userId, endedAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  message   String
  createdAt DateTime         @default(now())
  read      Boolean          @default(false)

  userId Int
  user   UserCredential @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, read])
}
