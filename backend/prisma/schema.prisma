generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum QueueStatus {
  OPEN
  CLOSED
}

enum QueueEntryStatus {
  WAITING
  SERVED
  CANCELED
}

enum NotificationStatus {
  SENT
  VIEWED
}

model UserCredential {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  profile       UserProfile?
  queueEntries  QueueEntry[]
  notifications Notification[]
}

model UserProfile {
  id          Int     @id @default(autoincrement())
  fullName    String
  email       String  @unique
  contactInfo String?
  preferences String?

  credentialId Int            @unique
  credential   UserCredential @relation(fields: [credentialId], references: [id])
}

model Service {
  id               Int    @id @default(autoincrement())
  name             String
  description      String
  expectedDuration Int
  priorityLevel    Int

  queues Queue[]
}

model Queue {
  id        Int         @id @default(autoincrement())
  status    QueueStatus @default(OPEN)
  createdAt DateTime    @default(now())

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  entries QueueEntry[]
}

model QueueEntry {
  id       Int              @id @default(autoincrement())
  position Int
  joinTime DateTime         @default(now())
  status   QueueEntryStatus @default(WAITING)

  queueId Int
  queue   Queue @relation(fields: [queueId], references: [id])

  userId Int
  user   UserCredential @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int                @id @default(autoincrement())
  message   String
  timestamp DateTime           @default(now())
  status    NotificationStatus @default(SENT)

  userId Int
  user   UserCredential @relation(fields: [userId], references: [id])
}
